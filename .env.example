# ST Agent 环境变量模板（入库的是这份；真实值在 .env，已被 .gitignore 忽略）
# 复制：cp .env.example .env 后填值。密钥/凭据永不入库（Git协作规范 §2 数据主权红线）。

# ─── Git 远端 ──────────────────────────────────────────────────
GITHUB_PAT=            # GitHub Personal Access Token（Contents: RW），仅本机使用
GIT_REMOTE_URL=        # 如 https://github.com/<owner>/st-agent.git

# ─── LLM 云端端点（用户自带 Key 直连，零中转）────────────────────
LLM_API_KEY=
LLM_BASE_URL=          # OpenAI 兼容 base URL，如 https://api.openai.com/v1
LLM_MODEL=

# ─── LLM 本地推理端点（可选）────────────────────────────────────
LOCAL_LLM_BASE_URL=    # 如 http://127.0.0.1:11434/v1（Ollama）
LOCAL_LLM_MODEL=

# ─── L5 触达渠道（M3 才用到）───────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
IM_WEBHOOK_URL=

# BaoStock 无需密钥（公开接口）；运行时凭据最终归 L0 密钥子系统（T-L0-002）
